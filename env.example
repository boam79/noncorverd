# Backend API URL
# 로컬 개발: http://localhost:3001/opendata
# Render 배포: https://noncorverd-backend.onrender.com/opendata
NEXT_PUBLIC_API_BASE_URL=https://noncorverd-backend.onrender.com/opendata

# 클라이언트 인증 토큰 (프론트 ↔ 백엔드)
NEXT_PUBLIC_CLIENT_OPENDATA_TOKEN=dev-client-token-12345
CLIENT_OPENDATA_TOKEN=dev-client-token-12345

# CORS 허용 도메인 (백엔드 .env에 설정)
CORS_ORIGINS=http://localhost:3000,https://noncorverd.vercel.app

# Monitoring (Optional)
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=

# Map Service (Optional)
NEXT_PUBLIC_MAP_KEY=
