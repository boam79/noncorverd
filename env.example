# Backend API URL
# 로컬 개발: http://localhost:3001/opendata
# Render 배포: https://noncorverd-backend.onrender.com/opendata
NEXT_PUBLIC_API_BASE_URL=https://noncorverd-backend.onrender.com/opendata

# 클라이언트 인증 토큰 (프론트 ↔ 백엔드)
NEXT_PUBLIC_CLIENT_OPENDATA_TOKEN=dev-client-token-12345
CLIENT_OPENDATA_TOKEN=dev-client-token-12345

# CORS 허용 도메인 (백엔드 .env에 설정)
CORS_ORIGINS=http://localhost:3000,https://noncorverd.vercel.app

# Monitoring (Optional)
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=

# Map Service (Optional)
NEXT_PUBLIC_MAP_KEY=

# 공공데이터 API (Vercel /api/opendata 직접 호출 시 서버에 필수)
OPENDATA_API_KEY=

# 선택: Upstash Redis — 설정 시 IP당 분당 요청 제한(App Route에서 적용)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 선택: GET /api/health/metrics — 인메모리 요청 카운트(헤더 x-metrics-secret)
METRICS_SECRET=

# 선택: UI v2 베타 리본(메인 상단). 1 이면 표시
NEXT_PUBLIC_UI_V2_BETA=
